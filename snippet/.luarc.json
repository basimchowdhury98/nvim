{
    "runtime": {
        "version": "LuaJIT",
        "path": [
            "lua/?.lua",
            "lua/?/init.lua"
        ],
        "pathStrict": true
    },
    "diagnostics": {
        "libraryFiles": "Disable"
    },
    "completion": {
        "workspaceWord": false,
    },
    "workspace": {
        "checkThirdParty": "Disable",
        "library": [
            "${env:VIMRUNTIME}",
            "${env:HOME}/.local/share/nvim/site/pack/core/opt/LuaSnip"
        ]
    }
}
